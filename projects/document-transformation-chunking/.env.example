# Document Transformation and Chunking - sample environment
# Note: current code primarily uses in-code defaults; these keys are for
# local run wrappers or future env wiring.

# Strategy profile: default | compact
CHUNK_PROFILE=default

# Frozen release strategy version
STRATEGY_VERSION=4.0.0

# Orchestrator runtime tuning
ORCHESTRATOR_TIMEOUT_SECONDS=2.0
ORCHESTRATOR_RETRY_ATTEMPTS=2

# Optional paths for local automation scripts
SOURCE_INDEX_PATH=../../data/manifests/source_index.csv
RAW_DATA_ROOT=../../data/raw
PROCESSED_DATA_ROOT=../../data/processed
