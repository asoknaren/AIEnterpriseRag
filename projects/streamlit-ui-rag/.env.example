# Streamlit UI and RAG - sample environment
# Note: current module-first implementation uses code defaults; these keys are
# intended for local app wrappers or future env wiring.

# API endpoint used by UI transport wrappers
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Client retry and timeout tuning
UI_CLIENT_TIMEOUT_SECONDS=2.0
UI_CLIENT_MAX_RETRIES=2

# UI default controls
UI_DEFAULT_TOP_K=5
UI_DEFAULT_STRATEGY_FILTER=all
UI_DEFAULT_SOURCE_FILTER=all

# Optional date window defaults (blank means disabled)
UI_DEFAULT_DATE_FROM=
UI_DEFAULT_DATE_TO=
