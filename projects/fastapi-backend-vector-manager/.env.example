# FastAPI Backend Vector Manager - sample environment

# Required by app settings (defaults to combined if unset)
# Allowed values: postgres-only | qdrant-only | combined
APP_PROFILE=combined

# Optional host/port for local server scripts
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional import path when launching from repository root
PYTHONPATH=./src

# Optional app metadata overrides for local tooling
APP_NAME=FastAPI Backend Vector Manager
APP_VERSION=0.1.0
