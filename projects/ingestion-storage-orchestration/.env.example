# Ingestion and Storage Orchestration - sample environment
# Note: current code primarily uses in-code defaults; these keys are for
# local run wrappers or future env wiring.

# Interface compatibility freeze
INTERFACE_VERSION=4.0.0

# Submission tuning
SUBMISSION_BATCH_SIZE=20

# Recovery and run-state tuning
RUN_STATE_BACKEND=memory
FORCED_INTERRUPTION_TEST_ENABLED=false

# Optional endpoint used by local integration scripts
FASTAPI_BASE_URL=http://127.0.0.1:8000
